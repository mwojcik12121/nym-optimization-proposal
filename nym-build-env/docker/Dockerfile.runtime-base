FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl iproute2 iptables jq libdbus-1-3 libssl3 \
      libsqlite3-0 libudev1 netcat-openbsd procps sqlite3 tini tzdata \
    && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="Nym test runtime dependency base" \
      nym.test.runtime.base="true" \
      nym.test.tester.layout-api="2"
